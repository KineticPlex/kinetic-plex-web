{
  "manifest_version": 3,
  "name": "KineticPlex Web",
  "version": "1.0.0",
  "action": {},
  "description": "Extensión web para la traducción de texto a lengua de señas en 3D.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:9000/*",
    "http://localhost:9001/*",
    "http://127.0.0.1:9001/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.tsx"]
    }
  ]
}